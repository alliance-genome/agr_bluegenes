{
 "templates": {
  "Gene_Orthologs": {
   "model": {
    "name": "genomic"
   },
   "title": "Gene --> Orthologs",
   "description": "For a given gene retrieve orthologs in other MOD organisms.",
   "select": [
    "Gene.primaryIdentifier",
    "Gene.secondaryIdentifier",
    "Gene.symbol",
    "Gene.name",
    "Gene.homologues.source",
    "Gene.organism.shortName",
    "Gene.homologues.homologue.organism.shortName",
    "Gene.homologues.homologue.primaryIdentifier",
    "Gene.homologues.homologue.secondaryIdentifier",
    "Gene.homologues.algorithmsAttempted",
    "Gene.homologues.algorithmsMatch",
    "Gene.homologues.isBestScore",
    "Gene.homologues.isBestReverseScore",
    "Gene.homologues.algorithms"
   ],
   "name": "Gene_Orthologs",
   "comment": "",
   "tags": [
    "im:aspect:Homology",
    "im:public"
   ],
   "rank": "6",
   "authorized": false,
   "orderBy": [
    {
     "Gene.primaryIdentifier": "ASC"
    }
   ],
   "where": [
    {
     "path": "Gene",
     "op": "LOOKUP",
     "code": "A",
     "editable": true,
     "switchable": false,
     "switched": "LOCKED",
     "value": "ZFIN:ZDB-GENE-030131-2808"
    }
   ]
  },
  "Gene_Homologs": {
   "model": {
    "name": "genomic"
   },
   "title": "Gene --> Non-Fungal and S. cerevisiae Homologs",
   "description": "Retrieve all DiOPT homologs for a specified <i>S. cerevisiae</i> <a href = \"https://sites.google.com/view/yeastgenome-help/analyze-help/yeastmine\">gene</a>.",
   "select": [
    "Gene.symbol",
    "Gene.secondaryIdentifier",
    "Gene.name",
    "Gene.sgdAlias",
    "Gene.homologues.homologue.organism.shortName",
    "Gene.homologues.homologue.primaryIdentifier",
    "Gene.homologues.homologue.symbol",
    "Gene.homologues.type",
    "Gene.homologues.dataSets.dataSource.name",
    "Gene.homologues.algorithms",
    "Gene.homologues.algorithmsMatch",
    "Gene.homologues.algorithmsAttempted",
    "Gene.homologues.isBestScore",
    "Gene.homologues.isBestReverseScore"
   ],
   "constraintLogic": "A and B and D",
   "name": "Gene_Homologs",
   "comment": "",
   "tags": [
    "im:aspect:Genome",
    "im:aspect:Homology",
    "im:aspect:YeastMine",
    "im:public"
   ],
   "rank": "22",
   "authorized": false,
   "orderBy": [
    {
     "Gene.homologues.homologue.organism.shortName": "ASC"
    }
   ],
   "where": [
    {
     "path": "Gene.homologues.dataSets.dataSource.name",
     "op": "ONE OF",
     "code": "D",
     "editable": false,
     "switchable": false,
     "switched": "LOCKED",
     "values": [
      "DiOPT"
     ]
    },
    {
     "path": "Gene.organism.shortName",
     "op": "=",
     "code": "B",
     "editable": false,
     "switchable": false,
     "switched": "LOCKED",
     "value": "S. cerevisiae"
    },
    {
     "path": "Gene",
     "op": "LOOKUP",
     "code": "A",
     "editable": true,
     "switchable": false,
     "switched": "LOCKED",
     "value": "ACT1"
    }
   ]
  },
