{:server-port 5000
 :logging-level "info"
 :google-analytics nil
 :bluegenes-tool-path "./tools"
 :bluegenes-deploy-path "/bluegenes"
 :bluegenes-backend-service-root nil
 :bluegenes-alliance-api-base "https://www.alliancegenome.org/api"
 :bluegenes-default-service-root "https://alliancemine.alliancegenome.org/alliancemine"
 :bluegenes-default-mine-name "AllianceMine"
 :bluegenes-default-namespace "alliancemine"
 :bluegenes-additional-mines [{:root "https://wormmine.alliancegenome.org/wormmine"
                              :name "WormMine"
                              :namespace "wormmine"}
                             {:root "https://flymine.alliancegenome.org/flymine"
                              :name "FlyMine"
                              :namespace "flymine"}
                             {:root "https://yeastmine.alliancegenome.org/yeastmine"
                              :name "YeastMine"
                              :namespace "yeastmine"
                              :abbrev "S. cerevisiae"
                              :default-organism "S. cerevisiae"}
                             {:root "https://mousemine.alliancegenome.org/mousemine"
                              :name "MouseMine"
                              :namespace "mousemine"
                              :external true}
                             {:root "https://www.humanmine.org/humanmine"
                              :name "HumanMine"
                              :namespace "humanmine"
                              :external false}]
 :hide-registry-mines true}
