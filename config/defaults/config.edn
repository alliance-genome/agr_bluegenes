{:server-port 5000
 :logging-level "info"
 :google-analytics nil
 :bluegenes-tool-path "./tools"
 :bluegenes-deploy-path "/bluegenes"
 :bluegenes-backend-service-root nil
 :bluegenes-default-service-root "https://alliancemine.alliancegenome.org/alliancemine"
 :bluegenes-default-mine-name "AllianceMine"
 :bluegenes-default-namespace "alliancemine"
 ;; Only :root, :name, :namespace and :external survive boot (init-configured-mine);
 ;; per-mine defaults such as the organism come from each mine's service/web-properties.
 ;; MouseMine is :external while mousemine.alliancegenome.org serves 1.8 (API v25), which BlueGenes
 ;; cannot load: the picker opens the 1.8 site in a new tab. Drop :external once 5.1 (API v35) serves it.
 :bluegenes-additional-mines [{:root "https://wormmine.alliancegenome.org/wormmine"
                               :name "WormMine"
                               :namespace "wormmine"}
                              {:root "https://flymine.alliancegenome.org/flymine"
                               :name "FlyMine"
                               :namespace "flymine"}
                              {:root "https://yeastmine.alliancegenome.org/yeastmine"
                               :name "YeastMine"
                               :namespace "yeastmine"}
                              {:root "https://mousemine.alliancegenome.org/mousemine"
                               :name "MouseMine"
                               :namespace "mousemine"
                               :external true}]
 :hide-registry-mines true}
